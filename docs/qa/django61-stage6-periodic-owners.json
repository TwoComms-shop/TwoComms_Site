{
  "schema_version": 1,
  "scope": "non-dtf",
  "global_heavy_process_lock": "tmp/twocomms_heavy_background.lock",
  "rollback": {
    "owner": "TwoComms release operator",
    "path": "scripts/install_instagram_periodic_jobs_cron.sh",
    "action": "while maintenance is active, stop the supervisor, run periodic and watchdog installers with --rollback then --check-rollback, only then revert code",
    "evidence_required": "pre-revert crontab with five legacy periodic owners and legacy watchdog, stopped supervisor identity, plus release SHA"
  },
  "jobs": [
    {
      "id": "django61_durable_tasks",
      "cadence": "* * * * *",
      "command": "manage.py run_durable_tasks --limit 25 --lease-seconds 60 --worker-id=cron-no-send",
      "managed_block": "# BEGIN TWOCOMMS DJANGO61 DURABLE TASKS",
      "owner_path": "scripts/install_django61_durable_tasks_cron.sh",
      "lock_path": "tmp/twocomms_heavy_background.lock",
      "flock": "exec /usr/bin/flock -n -E 75",
      "timeout": "/usr/bin/timeout --signal=TERM --kill-after=15s 240s",
      "timeout_required": true,
      "environment": [
        "DJANGO_ENV=production",
        "DJANGO_SETTINGS_MODULE=twocomms.production_settings"
      ]
    },
    {
      "id": "instagram_watchdog",
      "cadence": "* * * * *",
      "command": "scripts/instagram_bot_supervisor.py --ensure",
      "runtime": "stdlib",
      "managed_block": "# BEGIN TWOCOMMS INSTAGRAM BOT WATCHDOG",
      "owner_path": "scripts/install_instagram_bot_watchdog_cron.sh",
      "lock_path": "tmp/ig_bot_watchdog.lock",
      "flock": "/usr/bin/flock -n -E 75",
      "timeout": "/usr/bin/timeout --signal=TERM --kill-after=5s 20s",
      "timeout_required": true,
      "environment": [
        "DJANGO_ENV=production",
        "DJANGO_SETTINGS_MODULE=twocomms.production_settings"
      ]
    },
    {
      "id": "instagram_periodic_coordinator",
      "cadence": "* * * * *",
      "command": "manage.py run_instagram_periodic_jobs --budget-seconds 540",
      "managed_block": "# BEGIN TWOCOMMS INSTAGRAM PERIODIC JOBS v1",
      "owner_path": "scripts/install_instagram_periodic_jobs_cron.sh",
      "lock_path": "tmp/twocomms_heavy_background.lock",
      "flock": "/usr/bin/flock -n -E 75",
      "timeout": "/usr/bin/timeout --signal=TERM --kill-after=15s 600s",
      "timeout_required": true,
      "provides_lanes": [
        "order_telegram_reconcile",
        "ig_checkout_reconcile",
        "ig_order_fulfillment",
        "ig_deal_payments",
        "binotel_call_ai_analyses"
      ],
      "lane_deadlines_seconds": {
        "order_telegram_reconcile": 60,
        "ig_checkout_reconcile": 75,
        "ig_order_fulfillment": 75,
        "ig_deal_payments": 120,
        "binotel_call_ai_analyses": 180
      },
      "environment": [
        "DJANGO_ENV=production",
        "DJANGO_SETTINGS_MODULE=twocomms.production_settings"
      ]
    },
    {
      "id": "nova_poshta_tracking",
      "cadence": "*/5 * * * *",
      "command": "manage.py update_tracking_statuses",
      "managed_block": "# BEGIN TWOCOMMS NOVA POSHTA TRACKING",
      "owner_path": "scripts/install_nova_poshta_tracking_cron.sh",
      "lock_path": "tmp/twocomms_heavy_background.lock",
      "flock": "/usr/bin/flock -n -E 75",
      "timeout": "/usr/bin/timeout --signal=TERM --kill-after=15s 240s",
      "timeout_required": true,
      "environment": [
        "DJANGO_ENV=production",
        "DJANGO_SETTINGS_MODULE=twocomms.production_settings"
      ]
    },
    {
      "id": "product_catalog_image_jobs",
      "active": false,
      "cadence": "* * * * *",
      "command": "manage.py reconcile_image_optimization_jobs --max-jobs 4 --stale-after-seconds 1800 --allow-production",
      "managed_block": "# BEGIN TWOCOMMS PRODUCT CATALOG IMAGE JOBS",
      "owner_path": "scripts/install_product_catalog_image_jobs_cron.sh",
      "lock_path": "tmp/product_catalog_image_jobs.lock",
      "flock": "/usr/bin/flock -n",
      "timeout": "/usr/bin/timeout --signal=TERM --kill-after=30s 1500s",
      "timeout_required": true,
      "environment": [
        "DJANGO_ENV=production",
        "DJANGO_SETTINGS_MODULE=twocomms.production_settings"
      ]
    }
  ]
}
