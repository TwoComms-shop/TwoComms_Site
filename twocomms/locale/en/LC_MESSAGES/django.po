#: storefront/support_content.py:445
#: twocomms_django_theme/templates/pages/pro_brand.html:6
#: twocomms_django_theme/templates/pages/pro_brand.html:9
msgid "TwoComms — харківський бренд одягу про характер, стійкість і продовження"
msgstr "TwoComms — Kharkiv apparel brand about character, resilience and continuation"

#: storefront/support_content.py:446
msgid "TwoComms — український streetwear / military-adjacent бренд із Харкова. Одяг з кодом, сенсовими принтами, реальним походженням і філософією: не крапка, а продовження."
msgstr "TwoComms is a Ukrainian streetwear / military-adjacent brand from Kharkiv. Apparel with a code, meaningful prints, real origin and the philosophy: not a period, a continuation."

#: storefront/support_content.py:447
msgid "TwoComms, харківський бренд одягу, український streetwear бренд, military-adjacent одяг, одяг зі змістом, сенсові принти, дві коми, Харків"
msgstr "TwoComms, Kharkiv apparel brand, Ukrainian streetwear brand, military-adjacent apparel, apparel with meaning, meaningful prints, two commas, Kharkiv"

#: storefront/support_content.py:448
