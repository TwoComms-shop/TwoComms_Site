msgstr "Delivery & payment"

#: storefront/views/static_pages.py:1273
msgid "Категорія каталогу TwoComms з окремою підбіркою товарів."
msgstr "TwoComms catalog category with its own product selection."

#: storefront/views/static_pages.py:1283
#, python-format
msgid "Сторінка товару у категорії %(category)s."
