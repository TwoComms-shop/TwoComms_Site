msgstr "Brand"

#: storefront/support_content.py:449
#: twocomms_django_theme/templates/pages/pro_brand.html:14
msgid "TwoComms — не крапка. Продовження."
msgstr "TwoComms — not a period. A continuation."

#: storefront/support_content.py:450
msgid "TwoComms — харківський streetwear / military-adjacent бренд про характер, сенсові принти, внутрішню дисципліну і рух далі після критичної точки."
msgstr "TwoComms is a Kharkiv streetwear / military-adjacent brand about character, meaningful prints, inner discipline and moving forward after a critical point."

#: storefront/support_content.py:452
msgid "Made in Ukraine"
msgstr "Made in Ukraine"

#: storefront/support_content.py:453
