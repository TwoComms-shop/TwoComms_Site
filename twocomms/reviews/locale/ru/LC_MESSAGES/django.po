# Product community strings; separate from the storefront translation work.
msgid ""
msgstr "Project-Id-Version: TwoComms Community\nLanguage: ru\nContent-Type: text/plain; charset=UTF-8\nPlural-Forms: nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);\n"

msgid "Ім’я або нікнейм"
msgstr "Имя или никнейм"

msgid "Акаунт не потрібен. Ім’я обираєш ти."
msgstr "Аккаунт не нужен. Имя выбираешь ты."

msgid "Без реєстрації. Достатньо кількох речень."
msgstr "Без регистрации. Достаточно нескольких предложений."

msgid "Будь-яка чесна оцінка. Сторіс перевіряємо вручну. Участь добровільна, подарунок не гарантований."
msgstr "Любая честная оценка. Сторис проверяем вручную. Участие добровольное, подарок не гарантирован."

msgid "Більше, ніж відгук"
msgstr "Больше, чем отзыв"

msgid "Ваш відгук опубліковано"
msgstr "Ваш отзыв опубликован"

msgid "Ваш досвід уже допомагає іншим обрати."
msgstr "Ваш опыт уже помогает другим выбрать."

msgid "Ваш запис доступний у цьому браузері, поки зберігаються cookies. На спільному пристрої його можуть побачити інші користувачі."
msgstr "Ваша запись доступна в этом браузере, пока сохраняются cookies. На общем устройстве её могут увидеть другие пользователи."

msgid "Від 20 символів · без посилань і контактів"
msgstr "От 20 символов · без ссылок и контактов"

msgid "Відгук + сторіс з відміткою TwoComms = 2 заявки"
msgstr "Отзыв + сторис с отметкой TwoComms = 2 заявки"

msgid "Відгук про товар"
msgstr "Отзыв о товаре"

msgid "Відгук у межах програми заохочення"
msgstr "Отзыв в рамках программы поощрения"

msgid "Відгуки та коментарі"
msgstr "Отзывы и комментарии"

msgid "Гість · покупку не підтверджено"
msgstr "Гость · покупка не подтверждена"

msgid "Деталі мають значення"
msgstr "Детали имеют значение"

msgid "Для зв’язку залишаю email. Оцінка не впливає на участь."
msgstr "Оставляю email для связи. Оценка не влияет на участие."

msgid "До 5 фото · JPG, PNG, WebP · до 5 МБ кожне"
msgstr "До 5 фото · JPG, PNG, WebP · до 5 МБ каждое"

msgid "Додати деталі або фото"
msgstr "Добавить детали или фото"

msgid "Досвід з товаром"
msgstr "Опыт с товаром"

msgid "Дякуємо! Текст збережено та передано на модерацію."
msgstr "Спасибо! Текст сохранён и передан на модерацию."

msgid "Дякуємо, що поділилися. Після перевірки текст стане видимим для всіх. Публікуємо і позитивний, і критичний досвід."
msgstr "Спасибо, что поделились. После проверки текст станет виден всем. Публикуем и положительный, и критический опыт."

msgid "За бажанням"
msgstr "По желанию"

msgid "Заявку на участь збережено. Вона активується після публікації відгуку."
msgstr "Заявка на участие сохранена. Она активируется после публикации отзыва."

msgid "Кожен може написати відгук або коментар. Позначку «Покупку підтверджено» додаємо автоматично лише за оплаченим замовленням цього товару в акаунті. Гостям її не присвоюємо за введеним ім’ям чи email. Прибираємо спам, рекламу, контакти та образи — критична оцінка не є причиною відмови. Коментарі без оцінки не впливають на рейтинг."
msgstr "Каждый может написать отзыв или комментарий. Отметку «Покупка подтверждена» добавляем автоматически только по оплаченному заказу этого товара в аккаунте. Гостям её не присваиваем по введённому имени или email. Убираем спам, рекламу, контакты и оскорбления — критическая оценка не причина отказа. Комментарии без оценки не влияют на рейтинг."

msgid "Коментар"
msgstr "Комментарий"

msgid "Коментар / запитання"
msgstr "Комментарий / вопрос"

msgid "Коментар не пройшов правила публікації. Зв’яжіться з нами, якщо потрібне уточнення."
msgstr "Комментарий не прошёл правила публикации. Свяжитесь с нами, если нужно уточнение."

msgid "Комусь — саме те, що треба."
msgstr "Кому-то — именно то, что нужно."

msgid "Користувач · покупку не підтверджено"
msgstr "Пользователь · покупка не подтверждена"

msgid "Короткий заголовок"
msgstr "Короткий заголовок"

msgid "Лише для уточнень щодо відгуку. Без рекламних розсилок."
msgstr "Только для уточнений по отзыву. Без рекламных рассылок."

msgid "Можна покращити"
msgstr "Можно улучшить"

msgid "Місто"
msgstr "Город"

msgid "На модерації · видно тільки вам"
msgstr "На модерации · видно только вам"

msgid "Надсилаємо…"
msgstr "Отправляем…"

msgid "Надіслати відгук"
msgstr "Отправить отзыв"

msgid "Наприклад, Київ"
msgstr "Например, Киев"

msgid "Наступні"
msgstr "Следующие"

msgid "Не вдалося надіслати. Текст збережено — перевір з’єднання та спробуй ще раз."
msgstr "Не удалось отправить. Текст сохранён — проверь соединение и попробуй ещё раз."

msgid "Не опубліковано · видно тільки вам"
msgstr "Не опубликовано · видно только вам"

msgid "Не публікується · за бажанням"
msgstr "Не публикуется · по желанию"

msgid "Нові спочатку"
msgstr "Сначала новые"

msgid "Обери від 1 до 5"
msgstr "Выбери от 1 до 5"

msgid "Обери до 5 фото JPEG, PNG або WebP, не більше 5 МБ кожне."
msgstr "Выбери до 5 фото JPEG, PNG или WebP, не больше 5 МБ каждое."

msgid "Обов’язково"
msgstr "Обязательно"

msgid "Оцінок від відвідувачів:"
msgstr "Оценок от посетителей:"

msgid "Оцінюй, якщо вже маєш власний досвід із товаром. Для запитання обери коментар — без зірок."
msgstr "Оценивай, если уже есть личный опыт с товаром. Для вопроса выбери комментарий — без звёзд."

msgid "Очистити чернетку"
msgstr "Очистить черновик"

msgid "Першим завжди трохи особливо."
msgstr "Быть первым — немного особенно."

msgid "Пиши як гість"
msgstr "Пиши как гость"

msgid "Поділися досвідом після покупки — долучайся до розіграшу одягу з твоїм принтом і розробкою дизайну від TwoComms."
msgstr "Поделись опытом после покупки — участвуй в розыгрыше одежды с твоим принтом и разработкой дизайна от TwoComms."

msgid "Поділитися досвідом"
msgstr "Поделиться опытом"

msgid "Покажи річ у житті"
msgstr "Покажи вещь в жизни"

msgid "Покупку підтверджено"
msgstr "Покупка подтверждена"

msgid "Попередні"
msgstr "Предыдущие"

msgid "Посадка"
msgstr "Посадка"

msgid "Посадка на твоєму зрості. Тканина на дотик. Принт після прання. Саме це допомагає обирати."
msgstr "Посадка на твоём росте. Ткань на ощупь. Принт после стирки. Именно это помогает выбирать."

msgid "Принт"
msgstr "Принт"

msgid "Розкажи своїми словами"
msgstr "Расскажи своими словами"

msgid "Розподіл оцінок"
msgstr "Распределение оценок"

msgid "Сподобалось"
msgstr "Понравилось"

msgid "Спочатку текст бачиш лише ти та модератор. Публікуємо після перевірки — незалежно від оцінки. Надсилаючи, ти дозволяєш публікацію тексту, імені, міста й доданих фото."
msgstr "Сначала текст видишь только ты и модератор. Публикуем после проверки — независимо от оценки. Отправляя, ты разрешаешь публикацию текста, имени, города и добавленных фото."

msgid "Справжні враження. Без готових відповідей і зірок за замовчуванням."
msgstr "Настоящие впечатления. Без готовых ответов и звёзд по умолчанию."

msgid "Сторінки відгуків"
msgstr "Страницы отзывов"

msgid "Твоя думка важлива"
msgstr "Твоё мнение важно"

msgid "Твоя ідея. Наш кастом."
msgstr "Твоя идея. Наш кастом."

msgid "Твій досвід."
msgstr "Твой опыт."

msgid "Те, чого не видно на фото."
msgstr "То, чего не видно на фото."

msgid "Тканина"
msgstr "Ткань"

msgid "Тут буде живий досвід людей, які обирають TwoComms. Почни розмову — ми уважно читаємо кожне повідомлення."
msgstr "Здесь будет живой опыт людей, которые выбирают TwoComms. Начни разговор — мы внимательно читаем каждое сообщение."

msgid "Тут починається розмова"
msgstr "Здесь начинается разговор"

msgid "У профілі · покупку цього товару не підтверджено"
msgstr "В профиле · покупка этого товара не подтверждена"

msgid "Увійти"
msgstr "Войти"

msgid "Умови та спосіб надіслати сторіс"
msgstr "Условия и как отправить сторис"

msgid "Участь підтверджена. Кількість заявок:"
msgstr "Участие подтверждено. Количество заявок:"

msgid "Фото до відгуку"
msgstr "Фото к отзыву"

msgid "Хочу взяти участь у розіграші кастомного одягу. Погоджуюся з"
msgstr "Хочу участвовать в розыгрыше кастомной одежды. Соглашаюсь с"

msgid "Чернетка — у цій вкладці на 24 години. Фото після оновлення обери знову."
msgstr "Черновик — в этой вкладке на 24 часа. Фото после обновления выбери снова."

msgid "Чим хочеш поділитися?"
msgstr "Чем хочешь поделиться?"

msgid "Ще немає оцінок. Твій чесний відгук може стати першим."
msgstr "Оценок ещё нет. Твой честный отзыв может стать первым."

msgid "Що сподобалось? Що хотілося б покращити? Які деталі варто знати іншим?"
msgstr "Что понравилось? Что хотелось бы улучшить? Какие детали стоит знать другим?"

msgid "Як ми перевіряємо відгуки?"
msgstr "Как мы проверяем отзывы?"

msgid "Як сидить, відчувається й носиться? Розкажи своїми словами — допоможи комусь знайти свою річ."
msgstr "Как сидит, ощущается и носится? Расскажи своими словами — помоги кому-то найти свою вещь."

msgid "Як тебе підписати?"
msgstr "Как тебя подписать?"

msgid "Як тобі ця річ?"
msgstr "Как тебе эта вещь?"

msgid "правилами"
msgstr "правилами"

msgid "✓ Покупку цього товару підтверджено"
msgstr "✓ Покупка этого товара подтверждена"

msgid "Оберіть оцінку від 1 до 5."
msgstr "Выберите оценку от 1 до 5."

msgid "Приберіть посилання, контакти та HTML. Тут ділимося власним досвідом."
msgstr "Уберите ссылки, контакты и HTML. Здесь делимся личным опытом."

msgid "Обов’язково · не публікується"
msgstr "Обязательно · не публикуется"

msgid "Залиш email для зв’язку. Він не публікується."
msgstr "Оставь email для связи. Он не публикуется."

msgid "Розкажіть про свій досвід — мінімум 20 символів."
msgstr "Расскажите о своём опыте — минимум 20 символов."

msgid "Як вас підписати?"
msgstr "Как вас подписать?"

msgid "Текст відгуку має містити щонайменше 20 символів."
msgstr "Текст отзыва должен содержать минимум 20 символов."

msgid "Введіть ім'я для публікації."
msgstr "Введите имя для публикации."

msgid "Забагато спроб. Спробуйте через годину."
msgstr "Слишком много попыток. Попробуйте через час."

msgid "Ви вже залишили відгук або коментар до цього товару."
msgstr "Вы уже оставили запись этого типа об этом товаре."

msgid "Ваш відгук або коментар уже збережено."
msgstr "Ваш отзыв или комментарий уже сохранён."

msgid "Ваш відгук уже збережено."
msgstr "Ваш отзыв уже сохранён."

msgid "Не вдалося прочитати фото. Оберіть JPEG, PNG або WebP."
msgstr "Не удалось прочитать фото. Выберите JPEG, PNG или WebP."

msgid "Завелике або непідтримуване фото."
msgstr "Слишком большое или неподдерживаемое фото."

msgid "Відгуки"
msgstr "Отзывы"

msgid "Твоя думка допоможе іншим обрати."
msgstr "Твоё мнение поможет другим выбрать."

msgid "Написати відгук"
msgstr "Написать отзыв"

msgid "Оцінка"
msgstr "Оценка"

msgid "за бажанням"
msgstr "по желанию"

msgid "Без оцінки"
msgstr "Без оценки"

msgid "Зірки — якщо вже маєш досвід із цією річчю."
msgstr "Звёзды — если уже есть опыт с этой вещью."

msgid "Оціни товар, щоб доповнити свій попередній коментар."
msgstr "Оцени товар, чтобы дополнить предыдущий комментарий."

msgid "Твій відгук"
msgstr "Твой отзыв"

msgid "Що думаєш про цю річ?"
msgstr "Что думаешь об этой вещи?"

msgid "не публікується"
msgstr "не публикуется"

msgid "Додати фото"
msgstr "Добавить фото"

msgid "Надіслати"
msgstr "Отправить"

msgid "Відгук з’явиться після модерації."
msgstr "Отзыв появится после модерации."

msgid "Надсилаючи, ти дозволяєш публікацію імені, тексту та фото. Email залишається приватним."
msgstr "Отправляя, ты разрешаешь публикацию имени, текста и фото. Email остаётся приватным."

msgid "Ще немає відгуків. Будемо раді твоїй думці."
msgstr "Отзывов пока нет. Будем рады твоему мнению."

msgid "Про відгуки"
msgstr "Об отзывах"

msgid "Публікуємо чесні відгуки незалежно від оцінки. Прибираємо спам, рекламу й образи. Позначку покупки додаємо за оплаченим замовленням у профілі. Email гостя не є підтвердженням покупки."
msgstr "Публикуем честные отзывы независимо от оценки. Убираем спам, рекламу и оскорбления. Отметку покупки добавляем по оплаченному заказу в профиле. Email гостя не подтверждает покупку."

msgid "Ім’я"
msgstr "Имя"
